{
  "name": "nagular",
  "displayName": "nagular",
  "description": "Quick navigate on angular",
  "version": "1.0.0",
  "publisher": "nagular",
  "engines": {
    "vscode": "^1.108.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tardisbleu/vscode-nagular.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "Nagular",
        "properties": {
          "nagular.actionButton": {
            "title": "Show icon to navigate in action bar",
            "type": "boolean",
            "default": true,
            "description": "Show icon in action bar"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "nagular.goToTs",
        "title": "Nagular : Go to TS",
        "icon": "$(file-code)"
      },
      {
        "command": "nagular.goToHtml",
        "title": "Nagular : Go to Html",
        "icon": "$(code)"
      },
      {
        "command": "nagular.goToStyle",
        "title": "Nagular : Go to Style",
        "icon": "$(symbol-color)"
      },
      {
        "command": "nagular.goToTest",
        "title": "Nagular : Go to Test",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "config.nagular.actionButton && nagular.showActionButton",
          "command": "nagular.goToTs",
          "group": "navigation@1"
        },
        {
          "when": "config.nagular.actionButton && nagular.showActionButton",
          "command": "nagular.goToHtml",
          "group": "navigation@2"
        },
        {
          "when": "config.nagular.actionButton && nagular.showActionButton",
          "command": "nagular.goToStyle",
          "group": "navigation@3"
        },
        {
          "when": "config.nagular.actionButton && nagular.showActionButton",
          "command": "nagular.goToTest",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nagular.goToTs",
        "key": "ctrl+win+F5",
        "mac": "ctrl+Meta+F5"
      },
      {
        "command": "nagular.goToHtml",
        "key": "ctrl+win+F6",
        "mac": "ctrl+Meta+F6"
      },
      {
        "command": "nagular.goToStyle",
        "key": "ctrl+win+F7",
        "mac": "ctrl+Meta+F7"
      },
      {
        "command": "nagular.goToTest",
        "key": "ctrl+win+F8",
        "mac": "ctrl+Meta+F8"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.10",
    "@types/vscode": "^1.108.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
